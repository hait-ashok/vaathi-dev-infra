# Reference / bootstrap snippet. Committed backend.hcl matches these values for CI.
# After bootstrap apply you can regenerate with:
#   terraform -chdir=bootstrap output -raw backend_hcl_snippet > backend.hcl

bucket         = "vaathi-dev-tfstate"
key            = "vaathi-dev/terraform.tfstate"
region         = "eu-west-2"
encrypt        = true
dynamodb_table = "vaathi-dev-tf-locks"
